# Image to deploy (published by CI)
BACKEND_IMAGE=docker.io/minix16/remit-backend:main
FRONTEND_IMAGE=docker.io/minix16/remit-frontend:main

# Port exposure on NAS host
HOST_API_PORT=8000
HOST_FRONTEND_PORT=3000

# Backend app settings
APP_NAME=Kelea Digital Brain - MVP
API_PREFIX=
CORS_ORIGINS=http://localhost,http://localhost:3000,http://localhost:5173,http://127.0.0.1,http://127.0.0.1:3000,http://127.0.0.1:5173
DATABASE_URL=sqlite:////data/kelea.db
