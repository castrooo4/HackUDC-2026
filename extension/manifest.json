{
  "manifest_version": 3,
  "name": "Remit - Cerebro Digital",
  "version": "1.0.0",
  "description": "Captura rapida de URLs desde YouTube, Google y PDFs directo a tu inbox unico.",
  "permissions": [
    "contextMenus",
    "activeTab",
    "scripting",
    "clipboardRead",
    "storage",
    "geolocation"
  ],
  "host_permissions": [
    "<all_urls>",
    "http://127.0.0.1:8000/*",
    "http://localhost:8000/*",
    "https://remit-db.mintos.space/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.youtube.com/*"
      ],
      "js": [
        "content_scripts/youtube.js"
      ]
    },
    {
      "matches": [
        "*://*.google.com/*",
        "*://*.google.es/*"
      ],
      "js": [
        "content_scripts/google.js"
      ]
    },
    {
      "matches": [
        "<all_urls>"
      ],
      "css": [
        "content_scripts/styles.css"
      ],
      "js": [
        "content_scripts/toast.js",
        "content_scripts/widget.js",
        "content_scripts/screenshot.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "http://localhost:5173/*",
        "http://127.0.0.1:5173/*",
        "http://remit.mintos.space/*"
      ],
      "js": [
        "content_scripts/sync.js"
      ],
      "run_at": "document_start"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Guardar pestana actual en tu second brain",
    "default_icon": "content_scripts/remit-logo.png"
  },
  "icons": {
    "16": "content_scripts/remit-logo.png",
    "32": "content_scripts/remit-logo.png",
    "48": "content_scripts/remit-logo.png",
    "128": "content_scripts/remit-logo.png"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "content_scripts/remit-logo.png"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ]
}
